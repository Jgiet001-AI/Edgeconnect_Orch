# Orchestrator connection settings
# Copy this file to .env and fill in your real values.

# Fully-qualified domain name of the Orchestrator
ORCH_FQDN="your-orchestrator.example.cloud"

# Login credentials
ORCH_USER="user@example.com"
ORCH_PASSWORD="your-password-here"

# Login type (0 = local user)
ORCH_LOGIN_TYPE="0"

# Verify SSL certificates ("true" or "false")
ORCH_VERIFY_SSL="true"

# Log out at the end of the run. Default false so the session cached in Redis
# stays valid for reuse; each run overwrites the Redis entry. Note: leaving false
# keeps the Orchestrator session open until it idle-times-out on the server.
# Setting true logs out and skips the Redis write (logout would invalidate it).
ORCH_LOGOUT="false"

# Redis connection for caching the Orchestrator auth token (all optional)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
